# BusinessOS instance environment template.
# Copy to .env on the business VM. Never commit the populated file.

BUSINESSOS_INSTANCE_ID="example-business"
BUSINESS_NAME="Example Business"
# Sole source of stage: pre_acquisition | transition | operating.
# Changing stage requires a logged owner decision and service restart.
BUSINESS_STAGE="pre_acquisition"
OWNER_APPROVAL_REQUIRED="true"
PARTNER_APPROVAL_REQUIRED="true"

# Source locations. Leave unused integrations blank.
DATA_ROOM_URL=""
GOOGLE_DRIVE_DATA_ROOM_URL=""
SHAREPOINT_SITE_URL=""
NOTION_WORKSPACE_ID=""

# Core services.
DATABASE_URL=""
OPENAI_API_KEY=""

# Communications and meetings.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USERS=""
SLACK_BOT_TOKEN=""
MICROSOFT_TEAMS_TENANT_ID=""
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Documents and productivity.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Finance.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
PLAID_CLIENT_ID=""
PLAID_SECRET=""

# CRM, marketing, product, and web analytics.
CRM_PROVIDER=""
CRM_API_KEY=""
HUBSPOT_ACCESS_TOKEN=""
SALESFORCE_ACCESS_TOKEN=""
GA4_PROPERTY_ID=""
GOOGLE_ADS_CUSTOMER_ID=""
META_AD_ACCOUNT_ID=""
ADS_ACCOUNT_ID=""
SEARCH_CONSOLE_SITE_URL=""
POSTHOG_PROJECT_ID=""

# Optional inbound messaging.
SENDBLUE_API_KEY=""
SENDBLUE_SECRET_KEY=""
SENDBLUE_PHONE_NUMBER=""

# Optional normalized inbound-message gateway.
INBOUND_WEBHOOK_SECRET=""
INBOUND_WEBHOOK_PATH="/webhooks/inbound-message"
BUSINESSOS_GATEWAY_HOST="127.0.0.1"
BUSINESSOS_GATEWAY_PORT="8787"
BUSINESSOS_ROOT="/opt/businessos/core"
BUSINESSOS_EMPLOYEES_FILE="/opt/businessos/core/instance/employees.json"
BUSINESSOS_STATE_ROOT="/var/lib/businessos"
HERMES_BIN="hermes"
HERMES_RUN_AS=""

# Reporting cadence.
WEEKLY_REPORT_DAY="Friday"
BIWEEKLY_STRATEGIC_REVIEW_DAY="Friday"
MONTHLY_REPORT_DAY="Last business day"
